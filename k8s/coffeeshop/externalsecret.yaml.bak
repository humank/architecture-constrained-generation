{{- range $key, $svc := .Values.services }}
---
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: {{ $svc.name }}-external-secret
  namespace: {{ $.Values.global.namespace }}
  labels:
    app: {{ $svc.name }}
    app.kubernetes.io/name: {{ $svc.name }}
    app.kubernetes.io/part-of: coffeeshop
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: aws-secrets-manager
    kind: ClusterSecretStore
  target:
    name: {{ $svc.name }}-secrets
    creationPolicy: Owner
  data:
    - secretKey: DB_USERNAME
      remoteRef:
        key: coffeeshop-{{ $.Values.global.namespace }}-db
        property: username
    - secretKey: DB_PASSWORD
      remoteRef:
        key: coffeeshop-{{ $.Values.global.namespace }}-db
        property: password
{{- end }}
